# Copy to backend/.env for local development (never commit .env)
# Django loads this file automatically via python-dotenv (see settings.py).
# Quick setup: cd backend && ./setup_postgres.sh "YOUR_POSTGRES_URL"
# On Railway, set these on the WEB service (Clasmo_Diagnostics) — NOT on Postgres.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# REQUIRED — paste the FULL URL from Postgres → Connect → Public Network
# Host MUST contain: .proxy.rlwy.net
# Do NOT use: ${{Postgres.DATABASE_URL}}  (that gives postgres.railway.internal)
# Do NOT use: postgres.railway.internal
DATABASE_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:44947/railway
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:44947/railway

# Optional
# CORS_ALLOWED_ORIGINS=https://clasmodiagnostics.com,https://www.clasmodiagnostics.com
# GUNICORN_WORKERS=2
