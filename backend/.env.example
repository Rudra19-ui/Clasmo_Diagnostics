# Copy to backend/.env for local development (never commit .env)
# On Railway, set these on the WEB service (Clasmo_Diagnostics) — NOT on Postgres.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# REQUIRED on Railway web service — use the PUBLIC URL from Postgres → Connect
# Host must look like: xxxxx.proxy.rlwy.net
# Do NOT use postgres.railway.internal unless web + Postgres are in the same project.
DATABASE_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:PORT/railway

# Optional: set to the same public URL (or leave as Railway reference if same project)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:PORT/railway

# Optional
# CORS_ALLOWED_ORIGINS=https://clasmodiagnostics.com,https://www.clasmodiagnostics.com
# GUNICORN_WORKERS=2
