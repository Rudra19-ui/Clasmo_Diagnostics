# Copy to backend/.env for local development (never commit .env)
# On Railway, set these in the WEB service Variables tab — not on Postgres.

# Required in production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# PostgreSQL — on Railway WEB service, add BOTH (paste full URL if services are in different projects):
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
# DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
#
# If Postgres and web app are in the SAME Railway project, you can use references instead:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}

# Optional
# CORS_ALLOWED_ORIGINS=https://clasmodiagnostics.com,https://www.clasmodiagnostics.com
# GUNICORN_WORKERS=2
